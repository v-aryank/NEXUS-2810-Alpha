# Public API gateway origin embedded in the frontend build.
# Leave blank when the frontend and API are served from the same origin.
VITE_API_BASE_URL=

# Development-only Vite proxy target (never exposed in the frontend bundle or used in production).
ESP32_DEV_TARGET=http://192.168.1.50

# Production Node API/static server settings.
# ESP32_TARGET must be reachable from the host running this Node service.
ESP32_TARGET=http://192.168.1.50
ESP32_TIMEOUT_MS=5000
PORT=8080
HOST=0.0.0.0

# Optional comma-separated exact origins when the browser app is hosted separately.
# Leave blank for the recommended same-origin deployment.
ALLOWED_ORIGIN=
